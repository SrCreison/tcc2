datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model GameRound {
  id                String   @id @default(uuid())
  serverSeed        String
  clientSeed        String
  nonce             Int
  betAmount         Float
  payout            Float
  isBonusBuy        Boolean
  totalScatters     Int
  /// "normal" ou "demonstracao" — necessário para /api/verify recalcular
  /// a rodada com a MESMA tabela de pesos que foi usada originalmente.
  profile           String   @default("normal")
  history           Json     
  createdAt         DateTime @default(now())

  @@index([createdAt])
}
